# /opt/quiz/.env on the server (chmod 600). Never commit the filled-in copy.
QUIZ_STREAM_KEY=
# Game audio: pygame plays into a private null sink, FFmpeg records only that sink.
QUIZ_AUDIO_INPUT=pulse:quiz_sink.monitor
SDL_AUDIODRIVER=pulse
PULSE_SINK=quiz_sink
# Cost: 720p at 3000k uses about half the CPU and upload of 1080p at 6000k.
# Set QUIZ_STREAM_HEIGHT=1080 (and drop the bitrate line) for full HD on a bigger VM.
QUIZ_STREAM_HEIGHT=720
QUIZ_STREAM_BITRATE=3000k
