#!/usr/bin/env bash
# quizctl - run and configure The Lifelong Quiz on this server (run as root).
# See deploy/linux/SERVER.md for the full guide.
set -euo pipefail

APP=/opt/quiz
ENV_FILE=$APP/.env
SECRETS=$APP/secrets
START_DROPIN=/etc/systemd/system/quiz-start.timer.d/schedule.conf
STOP_DROPIN=/etc/systemd/system/quiz-stop.timer.d/schedule.conf

usage() {
    cat <<'EOF'
quizctl start                 start a show now (outside the schedule it ends after 3 hours)
quizctl stop                  end the show now
quizctl restart               restart the show (picks up new settings)
quizctl status                is it running, is it streaming, next scheduled show
quizctl logs [N]              follow the live log (or print the last N lines)
quizctl key                   set the YouTube stream key (typed hidden, never printed)
quizctl schedule              show the show schedule
quizctl schedule "18:00 01:00" 3h   shows start at these UTC times and run 3h (or 90m)
quizctl schedule off|on       pause / resume the automatic schedule
quizctl config                show all settings (stream key masked)
quizctl set NAME VALUE        change a setting, e.g. quizctl set QUIZ_STREAM_HEIGHT 1080
quizctl unset NAME            remove a setting (back to the default)
quizctl update                pull the latest code and restart a running show
quizctl youtube-client        store the Google OAuth client JSON (read from stdin)
quizctl youtube-auth          authorise the show to manage the channel's broadcasts (device code)
quizctl youtube-token         store a token made by the browser flow on a PC (read from stdin)
quizctl youtube-status        stream health and broadcast state, via the YouTube API
EOF
}

calendar_of() {  # the OnCalendar times a timer really uses (a drop-in's empty line resets the list)
    systemctl cat "$1" 2>/dev/null | awk -F= '/^OnCalendar=/ { if ($2 == "") n = 0; else t[n++] = $2 }
        END { for (i = 0; i < n; i++) { s = t[i]; sub(/^\*-\*-\* /, "", s); sub(/:00 UTC$/, "", s); printf "%s%s", (i ? " " : ""), s } }'
}

need_root() { [ "$(id -u)" = 0 ] || { echo "Run as root (sudo quizctl ...)" >&2; exit 1; }; }

set_env() {  # set_env NAME VALUE  (replaces or appends, keeps the file private)
    local name=$1 value=$2 tmp
    tmp=$(mktemp)
    grep -v "^${name}=" "$ENV_FILE" > "$tmp" || true
    printf '%s=%s\n' "$name" "$value" >> "$tmp"
    install -m 600 -o quiz -g quiz "$tmp" "$ENV_FILE"
    rm -f "$tmp"
}

restart_if_running() {
    if systemctl is-active --quiet quiz; then
        systemctl restart quiz
        echo "Show restarted with the new settings."
    else
        echo "Saved. It applies to the next show."
    fi
}

ytapi() {  # run quiz.ytapi as the quiz user, with the show's settings
    sudo -u quiz bash -c "cd $APP && venv/bin/python -m quiz.ytapi $1"
}

to_minutes() {  # 3h -> 180, 90m -> 90, 2h30m -> 150
    local d=$1 h=0 m=0
    [[ $d =~ ^([0-9]+)h ]] && h=${BASH_REMATCH[1]}
    [[ $d =~ ([0-9]+)m$ ]] && m=${BASH_REMATCH[1]}
    [[ $d =~ ^[0-9]+$ ]] && h=$d
    echo $((h * 60 + m))
}

MANUAL_END=quiz-manual-end   # transient timer that ends a show started by hand
MANUAL_HOURS=3

in_window() {  # the clock is inside a scheduled show (start N .. end N, by the timers' times)
    systemctl is-enabled --quiet quiz-start.timer || return 1
    local starts ends now i day s e
    read -r -a starts <<< "$(calendar_of quiz-start.timer)"
    read -r -a ends <<< "$(calendar_of quiz-stop.timer)"
    now=$(date -u +%s)
    for i in "${!starts[@]}"; do
        [ -n "${ends[$i]:-}" ] || continue
        for day in today yesterday; do
            s=$(date -u -d "$day ${starts[$i]} UTC" +%s)
            e=$(date -u -d "$day ${ends[$i]} UTC" +%s)
            [ "$e" -gt "$s" ] || e=$((e + 86400))
            if [ "$now" -ge "$s" ] && [ "$now" -lt "$e" ]; then return 0; fi
        done
    done
    return 1
}

show_schedule() {
    if ! systemctl is-enabled --quiet quiz-start.timer; then
        echo "Automatic schedule: OFF (start shows with 'quizctl start')"
    else
        echo "Automatic schedule: ON (times in UTC)"
    fi
    echo "Starts: $(calendar_of quiz-start.timer)"
    echo "Ends:   $(calendar_of quiz-stop.timer)"
    systemctl list-timers 'quiz-*' --no-pager --no-legend
}

cmd=${1:-help}; shift || true
case "$cmd" in
    start)
        need_root
        if systemctl is-active --quiet quiz; then echo "Show is already running."; exit 0; fi
        systemctl stop "$MANUAL_END.timer" 2>/dev/null || true
        systemctl start quiz
        if in_window; then
            echo "Show starting inside the schedule; it ends at the scheduled time."
        else
            systemd-run --quiet --collect --unit="$MANUAL_END" --on-active="${MANUAL_HOURS}h" \
                --timer-property=AccuracySec=1s /usr/local/bin/quizctl manual-end
            echo "Show starting; it ends in $MANUAL_HOURS hours unless a scheduled show takes over."
        fi
        echo "Watch it with: quizctl logs" ;;
    manual-end)   # fired by the transient timer from 'start'; a scheduled show that began meanwhile keeps running
        need_root
        if in_window; then echo "A scheduled show is running; the schedule ends it."
        else systemctl stop quiz; echo "Manual show ended after $MANUAL_HOURS hours."; fi ;;
    stop)    need_root; systemctl stop "$MANUAL_END.timer" 2>/dev/null || true; systemctl stop quiz; echo "Show stopped." ;;
    restart) need_root; systemctl restart quiz; echo "Show restarted." ;;
    status)
        if systemctl is-active --quiet quiz; then
            echo "Show: RUNNING since $(systemctl show quiz -p ActiveEnterTimestamp --value)"
            journalctl -u quiz -n 400 --no-pager -o cat | grep -E '^\[Broadcast\]|^\[Chat\]|^\[Stream\]|^YouTube' | tail -n 6
        else
            echo "Show: stopped"
        fi
        if grep -qE '^QUIZ_STREAM_KEY=.+' "$ENV_FILE"; then echo "Stream key: set"; else echo "Stream key: MISSING (run: quizctl key)"; fi
        if [ -f "$SECRETS/youtube_token.json" ]; then echo "YouTube API: authorised (the show manages its broadcasts)"
        else echo "YouTube API: not set up (docs/youtube-api.md)"; fi
        show_schedule ;;
    logs)
        if [ -n "${1:-}" ]; then journalctl -u quiz -n "$1" --no-pager -o cat
        else journalctl -u quiz -f -o cat; fi ;;
    key)
        need_root
        read -r -s -p "Paste the YouTube stream key and press Enter: " key; echo
        key=$(printf '%s' "$key" | tr -d '[:space:]')
        [ -n "$key" ] || { echo "Nothing entered, key unchanged."; exit 1; }
        set_env QUIZ_STREAM_KEY "$key"
        echo "Stream key saved (ends in ...${key: -4})."
        restart_if_running ;;
    schedule)
        need_root
        case "${1:-}" in
            "") show_schedule ;;
            off) systemctl disable --now quiz-start.timer quiz-stop.timer >/dev/null 2>&1; echo "Automatic schedule paused. A running show keeps running until 'quizctl stop'." ;;
            on)  systemctl enable --now quiz-start.timer quiz-stop.timer >/dev/null 2>&1; show_schedule ;;
            *)
                times=$1; mins=$(to_minutes "${2:-3h}")
                [ "$mins" -gt 0 ] || { echo "Duration must be like 3h, 90m or 2h30m" >&2; exit 1; }
                starts="[Timer]"$'
'"OnCalendar="; ends=$starts
                for t in $times; do  # check every time before touching the timers
                    [[ $t =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]] || { echo "Bad time '$t' (use HH:MM, UTC)" >&2; exit 1; }
                    end=$(date -u -d "1970-01-01 $t UTC + $mins minutes" +%H:%M)
                    starts+=$'
'"OnCalendar=*-*-* $t:00 UTC"
                    ends+=$'
'"OnCalendar=*-*-* $end:00 UTC"
                done
                mkdir -p "$(dirname "$START_DROPIN")" "$(dirname "$STOP_DROPIN")"
                printf '%s
' "$starts" > "$START_DROPIN"
                printf '%s
' "$ends" > "$STOP_DROPIN"
                was_on=$(systemctl is-active quiz || true)
                systemctl daemon-reload
                systemctl enable --now quiz-start.timer quiz-stop.timer >/dev/null 2>&1
                systemctl restart quiz-start.timer quiz-stop.timer
                # systemd fires a start time that lies between the last start and now (2026-10-25:
                # adding 13:00 at 15:44 started a show). Keep it only inside that show's hours.
                sleep 3
                if [ "$was_on" != active ] && systemctl is-active --quiet quiz; then
                    if in_window; then echo "A scheduled show is under way now, so it started."
                    else systemctl stop quiz; echo "Stopped a show the timer change started outside the schedule."; fi
                fi
                show_schedule ;;
        esac ;;
    config)
        sed -E 's/^(QUIZ_STREAM_KEY=).+(.{4})$/\1********\2/' "$ENV_FILE" | grep -vE '^\s*#|^\s*$' ;;
    set)
        need_root
        [ $# -eq 2 ] || { echo "Usage: quizctl set NAME VALUE" >&2; exit 1; }
        [[ $1 =~ ^[A-Z_][A-Z0-9_]*$ ]] || { echo "Bad setting name '$1'" >&2; exit 1; }
        [ "$1" != QUIZ_STREAM_KEY ] || { echo "Use 'quizctl key' for the stream key." >&2; exit 1; }
        set_env "$1" "$2"; echo "$1=$2"; restart_if_running ;;
    unset)
        need_root
        [ $# -eq 1 ] || { echo "Usage: quizctl unset NAME" >&2; exit 1; }
        tmp=$(mktemp); grep -v "^$1=" "$ENV_FILE" > "$tmp" || true
        install -m 600 -o quiz -g quiz "$tmp" "$ENV_FILE"; rm -f "$tmp"
        echo "Removed $1."; restart_if_running ;;
    update)
        need_root
        sudo -u quiz git -C "$APP" pull --ff-only
        sudo -u quiz "$APP/venv/bin/pip" install --quiet -r "$APP/requirements.txt"
        install -m 755 "$APP/deploy/linux/quizctl" /usr/local/bin/quizctl
        for u in quiz.service quiz-start.timer quiz-stop.service quiz-stop.timer; do
            install -m 644 "$APP/deploy/linux/$u" "/etc/systemd/system/$u"
        done
        systemctl daemon-reload
        echo "Preparing the show's sounds (up to a minute after a sound change)..."
        sudo -u quiz bash -c "cd $APP && set -a && . ./.env && set +a && venv/bin/python -m quiz.sounds"             || echo "Sound pre-render failed; the show renders them at start instead."
        echo "Updated to $(sudo -u quiz git -C "$APP" log --oneline -1)."
        restart_if_running ;;
    youtube-client)
        need_root
        install -d -m 700 -o quiz -g quiz "$SECRETS"
        tmp=$(mktemp); chmod 600 "$tmp"
        cat > "$tmp"
        grep -q '"client_id"' "$tmp" || { rm -f "$tmp"; echo "That is not an OAuth client JSON (no client_id)." >&2; exit 1; }
        install -m 600 -o quiz -g quiz "$tmp" "$SECRETS/youtube_client.json"; rm -f "$tmp"
        echo "OAuth client saved. Next: quizctl youtube-auth" ;;
    youtube-auth)
        need_root
        [ -f "$SECRETS/youtube_client.json" ] || { echo "No OAuth client yet: run quizctl youtube-client first." >&2; exit 1; }
        install -d -m 700 -o quiz -g quiz "$SECRETS"
        ytapi auth
        restart_if_running ;;
    youtube-token)   # a token made on the operator's PC by the browser flow (picks a brand-account channel)
        need_root
        install -d -m 700 -o quiz -g quiz "$SECRETS"
        tmp=$(mktemp); chmod 600 "$tmp"
        cat > "$tmp"
        grep -q '"refresh_token": *"[^"]' "$tmp" || { rm -f "$tmp"; echo "That is not a token JSON with a refresh token." >&2; exit 1; }
        install -m 600 -o quiz -g quiz "$tmp" "$SECRETS/youtube_token.json"; rm -f "$tmp"
        echo "YouTube token saved."
        ytapi status || true
        restart_if_running ;;
    youtube-status) need_root; ytapi status ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
